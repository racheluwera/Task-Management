generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
 
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  status      String   @default("pending")
  priority    String   @default("medium")
  dueDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}